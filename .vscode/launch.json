{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: CLI - Version (INFO)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=cor-code",
                    "--package=cor-code"
                ],
                "filter": {
                    "name": "cor-code",
                    "kind": "bin"
                }
            },
            "args": [
                "-v",
                "version"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Unit Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=cor-code"
                ],
                "filter": {
                    "name": "cor_code",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
